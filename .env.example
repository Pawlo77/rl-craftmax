# Copy to .env (git-ignored); make exports it to every target.
# Measured effect of each setting: knowledge/craftax/Craftax runtime setup.md

# Persistent XLA compilation cache: later runs skip recompiling unchanged code.
JAX_COMPILATION_CACHE_DIR=.cache/jax
JAX_PERSISTENT_CACHE_MIN_COMPILE_TIME_SECS=0

# Apple Silicon only: add the GPU backend for network updates. Use it only with
# code that places rollouts via device_roles(); otherwise everything runs on the
# GPU, which steps Craftax 3-4x slower than the CPU.
# JAX_PLATFORMS=metal,cpu

# CPU env shards are set in code (configure_runtime(host_devices=8)), not here:
# extra host devices slow down code that does not shard its env batch.
